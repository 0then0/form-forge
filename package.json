{
  "name": "form-forge",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "pnpm --filter @form-forge/web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @form-forge/web test:e2e",
    "test:production": "pnpm --filter @form-forge/web test:production",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "db:generate": "pnpm --filter @form-forge/web db:generate",
    "db:migrate": "pnpm --filter @form-forge/web db:migrate",
    "db:studio": "pnpm --filter @form-forge/web db:studio",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
