DATABASE_URL=postgresql://postgres:postgres@localhost:5432/form_forge
AUTH_SECRET=replace-with-at-least-32-random-characters
NEXTAUTH_URL=http://localhost:3000
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Optional sign-in providers. Set both values to enable a provider.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITLAB_ID=
AUTH_GITLAB_SECRET=
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
INNGEST_DEV=1
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=local
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
WEBHOOK_ENCRYPTION_KEY=base64-encoded-32-byte-key
FINGERPRINT_SECRET=replace-with-at-least-32-random-characters
# Set to 1 only behind a trusted reverse proxy. In development the client address
# comes from X-Forwarded-For. In production the proxy must overwrite
# X-Form-Forge-Client-IP, and the application port must not be public.
TRUST_PROXY=0
# Dedicated disposable database used only by integration tests.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/form_forge_test
