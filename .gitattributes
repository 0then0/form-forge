# Normalize source and documentation across platforms without rewriting files.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
*.gz binary
*.zip binary

# Keep the lockfile in diffs and reviews; identify generated database metadata.
pnpm-lock.yaml linguist-generated=true
apps/web/drizzle/meta/*.json linguist-generated=true
