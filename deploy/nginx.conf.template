upstream form_forge {
    zone form_forge 64k;
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;
    server web:3000 resolve;
}

server {
    listen 443 ssl;
    server_name ${PUBLIC_HOST};
    ssl_certificate /run/tls/fullchain.pem;
    ssl_certificate_key /run/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 8000000;
    client_body_timeout 15s;
    send_timeout 75s;

    # Scheduler calls the private origin using signed requests. Do not expose
    # registration, invocation, dashboard or internal testing controls here.
    location /api/inngest { return 404; }
    location /api/internal/ { return 404; }

    location / {
        proxy_pass http://form_forge;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Form-Forge-Client-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
    }
}
