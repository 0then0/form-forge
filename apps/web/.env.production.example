# Supply real values through the deployment's secret store. Never commit them.
DATABASE_URL=postgresql://user:password@database:5432/form_forge
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Optional sign-in providers. Set both values to enable a provider.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_CHATGPT_ID=
AUTH_CHATGPT_SECRET=
# Apple: Services ID and a signed client-secret JWT (rotate before expiry).
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
AUTH_GITLAB_ID=
AUTH_GITLAB_SECRET=
NEXTAUTH_URL=https://forms.example.org
APP_URL=https://forms.example.org
NEXT_PUBLIC_APP_URL=https://forms.example.org
INNGEST_DEV=0
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Optional self-hosted overrides. Leave unset when using managed Inngest:
# INNGEST_BASE_URL=http://inngest:8288
# INNGEST_SERVE_ORIGIN=http://web:3000
WEBHOOK_ENCRYPTION_KEY=
FINGERPRINT_SECRET=
TRUST_PROXY=1
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Do not set TEST_DATABASE_URL or E2E_PIPELINE_TOKEN in deployed runtimes.
