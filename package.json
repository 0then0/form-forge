{
  "name": "form-forge",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "pnpm --filter @form-forge/web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @form-forge/web test:e2e",
    "test:production": "pnpm --filter @form-forge/web test:production",
    "format": "biome format --write . && prettier --write \"**/*.{md,yml,yaml}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,yml,yaml}\"",
    "knip": "knip",
    "db:generate": "pnpm --filter @form-forge/web db:generate",
    "db:migrate": "pnpm --filter @form-forge/web db:migrate",
    "db:studio": "pnpm --filter @form-forge/web db:studio",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.2",
    "knip": "^6.41.0",
    "lefthook": "^2.2.1",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  }
}
